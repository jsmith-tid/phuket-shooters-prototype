{
  "name": "phuket-shooters-prototype",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-25",
  "keep_vars": true,
  "ratelimits": [
    { "name": "BOOKING_RATE_LIMITER", "namespace_id": "2026102501", "simple": { "limit": 10, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/booking-mode", "/api/booking-enquiry", "/api/group-enquiry"]
  }
}
